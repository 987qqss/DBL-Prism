<UserControl x:Class="SettingsModule.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PathButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Border Grid.Row="0" Background="#1E1E3A" BorderBrush="#2A2A4A" BorderThickness="1" CornerRadius="8" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙ 系统设置" FontSize="16" FontWeight="Bold" Foreground="#00D4FF" />
                    <TextBlock Text="所有配置文件统一存放在:" FontSize="12" Foreground="#94A3B8"
                               Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RootDir}" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" />
                    <Button Content="📂 打开根目录" Command="{Binding OpenRootCommand}"
                            Style="{StaticResource PathButtonStyle}" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 路径列表 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="#1E1E3A" BorderBrush="#2A2A4A"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PathItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="12,8" Background="#252536" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Foreground="#E2E8F0" FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}"
                                               Foreground="#00D4FF" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Description}"
                                               Foreground="#94A3B8" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="打开" Style="{StaticResource PathButtonStyle}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
