<UserControl x:Class="MonitorModule.Views.DeviceMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:monitor="clr-namespace:MonitorModule"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent"
             Unloaded="OnUnloaded">

    <UserControl.Resources>
        <!-- 独立窗口不继承 Shell 资源，这里内联 -->
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#00D4FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E3A" />
            <Setter Property="BorderBrush" Value="#2A2A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <monitor:DataPointTemplateSelector x:Key="DataPointTemplateSelector">
            <!-- 数值型 → 实时曲线卡片 -->
            <monitor:DataPointTemplateSelector.TrendTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,8" Padding="10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding PointName}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentText}" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Unit}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 迷你曲线（用 Polyline 简化渲染，避免 LiveCharts 绑定复杂度） -->
                            <Border Height="60" Margin="0,8,0,0" CornerRadius="4"
                                    Background="#0DFFFFFF">
                                <Polyline Points="{Binding TrendPoints}"
                                          Stroke="{StaticResource AccentCyanBrush}"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Bottom"
                                          Stretch="Uniform"
                                          Margin="4,4" />
                            </Border>

                            <!-- 报警标签 -->
                            <TextBlock Text="{Binding AlarmLevelText}" FontSize="11" FontWeight="Bold"
                                       Foreground="#EF4444" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </monitor:DataPointTemplateSelector.TrendTemplate>

            <!-- 布尔型 → 状态指示灯卡片 -->
            <monitor:DataPointTemplateSelector.IndicatorTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding PointName}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="20" Height="20"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#9CA3AF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter Property="Fill" Value="#22C55E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding OnOffText}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AlarmLevelText}" FontSize="11" FontWeight="Bold"
                                           Foreground="#EF4444" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </monitor:DataPointTemplateSelector.IndicatorTemplate>

            <!-- 字符串 → 文本卡片 -->
            <monitor:DataPointTemplateSelector.TextTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,8,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding PointName}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="{Binding CurrentText}" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </monitor:DataPointTemplateSelector.TextTemplate>
        </monitor:DataPointTemplateSelector>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📡 设备监控" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 数据点卡片网格 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DataPoints}"
                          ItemTemplateSelector="{StaticResource DataPointTemplateSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
